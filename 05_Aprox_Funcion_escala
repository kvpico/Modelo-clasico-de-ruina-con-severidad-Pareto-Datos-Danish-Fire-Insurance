###############################################################
# 05_APROX_FUNCION_ESCALA.R
# Modelo clásico de Cramér-Lundberg
# Severidad: Pareto Tipo I
# Método numérico: Gaver-Stehfest
###############################################################

###############################################################
# 1. PARÁMETROS DEL MODELO
###############################################################

# Se utilizan los parámetros ya calculados en el archivo 04.
# No se vuelven a asignar lambda, alpha, xm ni c.

variables_necesarias <- c(
  "lambda_hat", "alpha_hat", "xm_hat",
  "mean_xi", "theta_loading",
  "c", "psi_prime_0", "psi"
)

faltantes <- variables_necesarias[
  !vapply(variables_necesarias, exists, logical(1),
          envir = .GlobalEnv)
]

if (length(faltantes) > 0) {
  stop("Faltan variables del archivo 04: ",
       paste(faltantes, collapse = ", "))
}

stopifnot(
  is.function(psi),
  lambda_hat > 0,
  alpha_hat > 1,
  xm_hat > 0,
  theta_loading > 0,
  c > 0,
  psi_prime_0 > 0
)

# Verificar coherencia del principio del valor esperado
media_verificada <- alpha_hat * xm_hat / (alpha_hat - 1)
c_verificada <- (1 + theta_loading) *
  lambda_hat * media_verificada

margen_verificado <- c_verificada -
  lambda_hat * media_verificada

stopifnot(
  isTRUE(all.equal(mean_xi, media_verificada)),
  isTRUE(all.equal(c, c_verificada)),
  isTRUE(all.equal(psi_prime_0, margen_verificado))
)

cat("\n--- PARÁMETROS DEL MODELO ---\n")
cat("Lambda:", lambda_hat, "\n")
cat("Alpha:", alpha_hat, "\n")
cat("xm:", xm_hat, "\n")
cat("Media Pareto:", mean_xi, "\n")
cat("Prima c:", c, "\n")
cat("Margen de seguridad:", psi_prime_0, "\n")


###############################################################
# 2. COEFICIENTES DE GAVER-STEHFEST
###############################################################

stehfest_coef <- function(N) {

  if (length(N) != 1 || !is.finite(N) ||
      N < 2 || N %% 1 != 0 || N %% 2 != 0) {
    stop("N debe ser un entero positivo y par.")
  }

  V <- numeric(N)

  for (k in seq_len(N)) {

    suma <- 0

    j_inicio <- floor((k + 1) / 2)
    j_fin <- min(k, N / 2)

    for (j in j_inicio:j_fin) {

      termino <- j^(N / 2) * factorial(2 * j) /
        (
          factorial(N / 2 - j) *
          factorial(j) *
          factorial(j - 1) *
          factorial(k - j) *
          factorial(2 * j - k)
        )

      suma <- suma + termino
    }

    V[k] <- (-1)^(k + N / 2) * suma
  }

  return(V)
}


###############################################################
# 3. APROXIMACIÓN DE LA FUNCIÓN DE ESCALA W(u)
###############################################################

# Transformada de Laplace:
# L{W}(beta) = 1 / psi(beta)

W_gaver <- function(u, N = 8) {

  if (length(u) != 1 || !is.finite(u) || u < 0) {
    stop("u debe ser un número finito no negativo.")
  }

  # Valor teórico en el origen para Cramér-Lundberg
  if (u == 0) {
    return(1 / c)
  }

  V <- stehfest_coef(N)
  ln2 <- log(2)

  suma <- 0

  for (k in seq_len(N)) {

    beta_k <- k * ln2 / u
    psi_k <- psi(beta_k)

    if (!is.finite(psi_k) || psi_k <= 0) {
      stop("Error al evaluar psi(beta) para beta = ",
           beta_k)
    }

    suma <- suma + V[k] / psi_k
  }

  W_u <- (ln2 / u) * suma

  return(W_u)
}


###############################################################
# 4. PROBABILIDAD DE RUINA EVENTUAL
###############################################################

# Psi(u) = 1 - psi'(0+) * W(u)

ruin_prob <- function(u, N = 8) {

  W_u <- W_gaver(u, N)

  prob_ruina <- 1 - psi_prime_0 * W_u

  return(prob_ruina)
}


###############################################################
# 5. COMPROBACIONES TEÓRICAS
###############################################################

cat("\n--- COMPROBACIONES TEÓRICAS ---\n")

# Función de escala en el origen
W_cero <- W_gaver(0)

cat("W(0) calculado:", W_cero, "\n")
cat("W(0) teórico:", 1 / c, "\n")

# Probabilidad de ruina en u = 0
ruina_cero <- ruin_prob(0)

ruina_cero_teorica <- 1 / (1 + theta_loading)

cat("Ruina en u=0:", ruina_cero, "\n")
cat("Ruina teórica en u=0:",
    ruina_cero_teorica, "\n")

stopifnot(
  isTRUE(all.equal(W_cero, 1 / c)),
  isTRUE(all.equal(ruina_cero,
                   ruina_cero_teorica))
)


###############################################################
# 6. ESTABILIDAD NUMÉRICA
###############################################################

# Comparación con distintos números de términos

u_prueba <- c(0.5, 1, 2, 5, 10, 20)

comparacion_05 <- data.frame(
  Capital = u_prueba,
  N8 = sapply(u_prueba, ruin_prob, N = 8),
  N10 = sapply(u_prueba, ruin_prob, N = 10),
  N12 = sapply(u_prueba, ruin_prob, N = 12)
)

comparacion_05$Dif_8_10 <- abs(
  comparacion_05$N8 - comparacion_05$N10
)

comparacion_05$Dif_10_12 <- abs(
  comparacion_05$N10 - comparacion_05$N12
)

cat("\n--- COMPARACIÓN DE ESTABILIDAD ---\n")

print(comparacion_05, digits = 8)


###############################################################
# 7. CÁLCULO DE PROBABILIDADES DE RUINA
###############################################################

u_vals <- seq(0.5, 20, length.out = 100)

ruin_vals <- sapply(
  u_vals,
  ruin_prob,
  N = 8
)

stopifnot(all(is.finite(ruin_vals)))

cat("\n--- RESULTADOS DE RUINA ---\n")

cat("Probabilidad mínima:",
    min(ruin_vals), "\n")

cat("Probabilidad máxima:",
    max(ruin_vals), "\n")

cat("Probabilidades entre 0 y 1:",
    all(ruin_vals >= 0 & ruin_vals <= 1), "\n")

cat("Probabilidad no creciente:",
    all(diff(ruin_vals) <= 1e-8), "\n")

